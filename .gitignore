# =============================================================================
# .gitignore — Cell Segmentation IMC Benchmark
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb

# ---- Data files (too large for git — download separately) ----
data/
*.npz
*.npy
*.h5
*.hdf5
*.zarr/

# ---- Model weights ----
*.pth
*.pt
*.h5
*.pb
*.ckpt
*.keras
*.cellpose

# ---- Results (large CSVs and pickle files) ----
results/
*.csv
*.pkl
*.pickle

# ---- Figures (generated, not tracked) ----
paper/Figures/*.pdf
paper/Figures/*.png
Figures/

# ---- LaTeX build artefacts ----
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
paper/*.pdf

# ---- OS artefacts ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- HPC job logs (keep locally, not in repo) ----
logs/
slurm-*.out

# ---- Secrets and credentials ----
*.env
.env
config_local.py
